# HTTP
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the admin UI URL)
CORS_ORIGIN=http://localhost:5173

# Storage
DATABASE_PATH=./data/inventory.db

# Auth: the first user. It is created on startup (and by db:seed / db:reset) only
# while the database has no users. After that, manage users from the admin UI.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=8h

LOG_LEVEL=info

# Public address where /health lives; mobile API_BASE_URL matches this, VITE_API_URL adds /api.
# Required HTTPS in production. A reverse-proxy path prefix is supported.
PUBLIC_URL=http://localhost:4000
# Set to 1 behind a single reverse proxy or tunnel.
TRUST_PROXY=false
# Largest single measurement file, in MB (1–500).
UPLOAD_MAX_FILE_MB=50
