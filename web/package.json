    "@mui/system": "^7.3.11",
    "@tanstack/react-query": "^5.104.3",
    "exceljs": "^4.4.0",
    "ra-data-simple-rest": "^5.15.4",
    "ra-i18n-polyglot": "^5.15.4",
    "react": "^19.2.8",
    "react-admin": "^5.15.4",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
