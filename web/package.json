{
  "name": "cleaning-inventory-admin",
  "private": true,
  "version": "1.0.0",
  "description": "React Admin UI for the cleaning products inventory (SPEC-002)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
